diff --git a/tests/CityResourceFlowChecks.h b/tests/CityResourceFlowChecks.h
new file mode 100644
index 0000000..caf340b
--- /dev/null
+++ b/tests/CityResourceFlowChecks.h
@@ -0,0 +1,148 @@
+#pragma once
+#include "TestFramework.h"
+#include "world/settlements/ResourceFlowHistory.h"
+#include "world/settlements/SettlementFoodDemand.h"
+#include "world/settlements/SettlementMap.h"
+#include "world/settlements/commands/SettlementCommandDefinition.h"
+#include "world/settlements/objects/SettlementObjectDefinition.h"
+#include <cmath>
+#include <limits>
+
+namespace Paladin::Test
+{
+    inline void runCityResourceFlowChecks()
+    {
+        const auto close = [](double a, double b)
+        { return std::abs(a - b) < 1e-8; };
+        ResourceFlowHistory history;
+        history.record("stone", 10, 4, 0);
+        history.record("stone", 10.75, 2, 1);
+        history.record("stone", 9, 1, 0);
+        history.record("stone", 11, -100, 0);
+        history.record("stone", std::numeric_limits<double>::infinity(), 9, 0);
+        PALADIN_CHECK(close(history.lastDay("stone", 10).production, 7));
+        PALADIN_CHECK(close(history.lastDay("stone", 10).depletion, 1));
+        PALADIN_CHECK(close(history.lastDay("stone", 1449).production, 6));
+        PALADIN_CHECK(close(history.lastDay("stone", 1450).production, 0));
+        PALADIN_CHECK(close(history.lastDay("missing", 100).depletion, 0));
+        // Multiple calls within one minute, and a long simulation lifetime,
+        // cannot turn this into a lifetime average or a startup extrapolation.
+        for (int minute = 0; minute < 3000; ++minute)
+        {
+            history.record("lumber", minute, 1, .25);
+            history.record("lumber", minute + .5, 1, .25);
+        }
+        PALADIN_CHECK(close(history.lastDay("lumber", 2999).production, 2880));
+        PALADIN_CHECK(close(history.lastDay("lumber", 2999).depletion, 720));
+        PALADIN_CHECK(close(history.lastDay("lumber", 5000).production, 0));
+
+        const auto land = []
+        {
+            SettlementGrid grid(40, 40);
+            for (int y = 0; y < 40; ++y)
+                for (int x = 0; x < 40; ++x)
+                    grid.tile({x, y})->terrain = TerrainType::Land;
+            return SettlementMap(std::move(grid), {0, 0}, 1, 1, 40, 9871);
+        };
+        const auto complete = [](SettlementMap& map, std::string_view type,
+                                 SettlementObjectFootprint footprint)
+        {
+            auto definition = *SettlementObjectCatalog::definition(type);
+            definition.bypassesConstruction = true;
+            PALADIN_CHECK(map.objectState().placeCompletedObject(
+                map.grid(), definition, footprint));
+            map.logistics.synchronize(map.objectState(), 0);
+            return map.objectState().completedObjects().back().id;
+        };
+        auto map = land();
+        const auto keep = complete(map, SettlementObjectTypes::CityKeep,
+                                   {{2, 2}, 5, 7});
+        SettlementCitizenState people;
+        PALADIN_CHECK(people.initialize(4, 10));
+        people.placeUnpositionedCitizens(map);
+        auto& child = const_cast<SettlementCitizen&>(people.citizens()[2]);
+        child.child = true;
+        child.ageYears = 2;
+        auto& older = const_cast<SettlementCitizen&>(people.citizens()[3]);
+        older.child = true;
+        older.ageYears = 9;
+        const auto& policy = map.activities.policy;
+        const double demand = 2 * policy.hungerPerDay / policy.mealRestoration +
+            citizenFoodPerDay(child, policy) + citizenFoodPerDay(older, policy);
+        PALADIN_CHECK(close(demand, 5.3));
+        child.health = 0;
+        PALADIN_CHECK(citizenFoodPerDay(child, policy) == 0);
+        child.health = 100;
+        map.logistics.drop({12, 12}, "meat", 20, 0);
+        // Starting goods and moving them around are not production.
+        const auto& before = map.commerce.dailyResourceReport(map, people, 0);
+        PALADIN_CHECK(before.at("fish").production == 0);
+        PALADIN_CHECK(close(before.at("fish").depletion, demand / 2));
+        PALADIN_CHECK(close(before.at("meat").depletion, demand / 2));
+        PALADIN_CHECK(before.at("stone").depletion == 0);
+        map.commerce.recordFlow(map.logistics.forObject(keep), InventoryId{987},
+                                "fish", 8);
+        PALADIN_CHECK(map.commerce.resourceTotals().empty());
+        // Recent diet apportions the one needs-derived city demand.
+        map.commerce.recordConsumption("fish", 3);
+        map.commerce.recordConsumption("meat", 1);
+        map.commerce.recordProduction("fish", 7);
+        const auto report = map.commerce.dailyResourceReport(map, people, 1);
+        PALADIN_CHECK(close(report.at("fish").production, 7));
+        PALADIN_CHECK(close(report.at("fish").depletion, demand * .75));
+        PALADIN_CHECK(close(report.at("meat").depletion, demand * .25));
+        PALADIN_CHECK(close(report.at("fish").depletion + report.at("meat").depletion,
+                            demand));
+        PALADIN_CHECK(report.at("fish").foodEstimate);
+        PALADIN_CHECK(!report.at("stone").foodEstimate);
+        const auto totals = map.commerce.resourceTotals();
+        for (int frame = 0; frame < 100; ++frame)
+            PALADIN_CHECK(close(map.commerce.dailyResourceReport(map, people, 1)
+                                   .at("fish").depletion, demand * .75));
+        PALADIN_CHECK(map.commerce.resourceTotals().at("fish").consumed ==
+                        totals.at("fish").consumed);
+        auto otherCity = land();
+        PALADIN_CHECK(otherCity.commerce.dailyResourceReport(otherCity, people, 1)
+                          .at("fish").production == 0);
+        PALADIN_CHECK(otherCity.commerce.dailyResourceReport(otherCity, people, 1)
+                          .at("fish").depletion == 0);
+
+        // Exercise actual gathering, hunting, fuel and construction endpoints,
+        // not just the report API. Refunds/hauling remain excluded.
+        auto work = land();
+        complete(work, SettlementObjectTypes::CityKeep, {{2, 2}, 5, 7});
+        SettlementCitizenState worker;
+        PALADIN_CHECK(worker.initialize(1, 24));
+        worker.placeUnpositionedCitizens(work);
+        auto& person = const_cast<SettlementCitizen&>(worker.citizens().front());
+        person.hunger = 0;
+        person.energy = 100;
+        work.naturalFeatures().set({9, 10}, NaturalFeatureKind::Tree);
+        PALADIN_CHECK(work.commandState().add(work, SettlementCommandTypes::ChopTree,
+                                             {{9, 10}, 1, 1}, worker));
+        work.activities.tick(work, worker, 360, 100);
+        PALADIN_CHECK(work.naturalFeatures().at({9, 10}).kind == NaturalFeatureKind::None);
+        PALADIN_CHECK(work.commerce.resourceTotals().at("lumber").produced == 4);
+        const auto cow = work.animals.spawn(work, "cow", {25, 25});
+        PALADIN_CHECK(cow);
+        PALADIN_CHECK(work.animals.designate({{25, 25}, 1, 1}, AnimalOrder::Hunt));
+        PALADIN_CHECK(work.animals.reserve(cow, person.id, {}, work));
+        const int meat = animalSpecies("cow")->huntMeat;
+        PALADIN_CHECK(work.animals.hunt(cow, person.id, work, 460));
+        PALADIN_CHECK(work.commerce.resourceTotals().at("meat").produced == meat);
+        work.commerce.captureInactive(work, worker);
+        work.commerce.tickInactive(work, worker, 460, 30);
+        PALADIN_CHECK(work.commerce.resourceTotals().at("meat").produced == meat);
+        PALADIN_CHECK(work.commerce.resourceTotals().at("lumber").produced == 4);
+        work.commerce.resumeActive();
+        PALADIN_CHECK(work.objectState().createConstructionSites(
+            work.grid(), *SettlementObjectCatalog::definition(SettlementObjectTypes::House),
+            {{12, 5}, 5, 5}));
+        work.activities.tick(work, worker, 490, 450);
+        PALADIN_CHECK(work.objectState().completedObjectAt({12, 5}));
+        PALADIN_CHECK(work.commerce.resourceTotals().at("stone").consumed == 8);
+        PALADIN_CHECK(work.commerce.resourceTotals().at("lumber").consumed ==
+                        16 + work.heating.lumberBurned());
+        PALADIN_CHECK(work.heating.lumberBurned() > 0);
+    }
+} // namespace Paladin::Test
