# Default-deny: publish source and explicitly approved game/art inputs.
# Local notes, arbitrary screenshots, and generated files stay private.
*
!*/

# C, C++, C#, and assembly source.
!*.c
!*.h
!*.cc
!*.cpp
!*.cxx
!*.c++
!*.hh
!*.hpp
!*.hxx
!*.h++
!*.inl
!*.ipp
!*.tpp
!*.ixx
!*.cppm
!*.cs
!*.csx
!*.asm
!*.s
!*.S
!*.inc

# Build definitions and repository instructions.
!*.csproj
!CMakeLists.txt
!*.cmake
!*.cmake.in
!/.gitignore
!/AGENTS.md

# Authored runtime configuration, sprite recipes, lighting, and palettes.
!/config/*.catalog
!/config/*.hex
!/config/*.gpl
!/config/*.pal

# Runtime assets, including sprites, atlases, and the game's font assets.
# Keep their redistribution/attribution notices with them.
!/assets/
!/assets/**
!/licenses/
!/licenses/**

# Other local references remain private. Only the agreed art-direction area
# includes masters (Krita/Aseprite/etc.), exports, tools, notes, and previews.
/docs/
/sources/
/handoffs/*
!/handoffs/art-direction/
!/handoffs/art-direction/**

# These exclusions must follow the art allowlist: generated/vendor source and
# build output must stay ignored even when nested in an approved art folder.
.git/
.vs/
.vscode/
.idea/
.cache/
out/
build/
build-*/
cmake-build-*/
CMakeFiles/
_deps/
Testing/
test-results/
coverage/
coverage-*/
node_modules/
.venv/
venv/
__pycache__/
renderer-test-fixture/

# Editor/OS debris is not an art master or a review image.
*.tmp
*.bak
*.kra~
*.ora~
*.ase~
*.aseprite~
*.psd~
.DS_Store
Thumbs.db
desktop.ini
